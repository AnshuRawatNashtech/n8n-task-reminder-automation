    {
      "parameters": {
        "sendTo": "={{ $json['Employee Email'] }}",
        "subject": "={{ 'Reminder – ' + $json['Task Name'] }}",
        "emailType": "text",
        "message": "={{ 'Hi ' + (($json['Assigned Employee'] || 'there').split(' ')[0]) + ',\\n\\nThis is a reminder that your task \"' + $json['Task Name'] + '\" is still pending.\\nDue Date: ' + DateTime.fromISO(String($json['Due Date'])).toFormat('dd-LLL-yyyy') + '\\nPlease complete the task before the due date.\\n\\nThanks,' }}",
